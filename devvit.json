{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ModSignal",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "ModSignal Dashboard",
        "description": "Open the ModSignal moderation dashboard",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Dismiss Alert",
        "description": "Dismiss a ModSignal alert",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dismiss-alert"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostCreate": "/internal/triggers/on-post-create",
    "onCommentCreate": "/internal/triggers/on-comment-create",
    "onCronTick": "/internal/triggers/on-cron-tick"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "bot_pew1_dev"
  }
}
